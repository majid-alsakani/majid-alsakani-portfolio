{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signalroom.dev/schemas/change-manifest.schema.json",
  "title": "SignalRoom Change Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "service", "commit", "author", "files"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "service": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "enum": ["development", "staging", "production"]},
    "commit": {"type": "string", "minLength": 7},
    "author": {"type": "string", "minLength": 1},
    "summary": {"type": "string"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "risk"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["source", "test", "config", "contract", "dependency", "docs"]},
          "risk": {"type": "string", "enum": ["low", "medium", "high"]}
        }
      }
    }
  }
}
